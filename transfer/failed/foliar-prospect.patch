 Phase/include/Phase.hpp                       |   2 +-
 Phase/include/PhaseDAO.hpp                    |  36 ----
 .../ProspectExternalModule.hpp                |  96 +++++++++++
 .../lambertian/Lambertian.hpp                 |  79 +--------
 .../vegetation/UnderstoryModel.hpp            |  32 ++++
 .../vegetation/UnderstoryMulti.hpp            |  51 +++++++
 Phase/src/Phase.cpp                           | 140 +++++++--------
 Phase/src/PhaseDAO.cpp                        | 163 ------------------
 Phase/src/PhaseVegetation.cpp                 |   2 +-
 10 files changed, 268 insertions(+), 358 deletions(-)
 create mode 100644 Phase/include/inputs/storage/opticalMaterials/ProspectExternalModule.hpp
 create mode 100644 Phase/include/inputs/storage/opticalMaterials/vegetation/UnderstoryModel.hpp

