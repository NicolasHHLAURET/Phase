+								std::vector<std::vector<std::vector<double> > > & fluorescenceMatrix,
+								const phsdata::UnderstoryModel & model,
+								unsigned int modelIndex,
+								const PhaseGeneralParametersDTO & genDTO,
+								unsigned int face) const {
